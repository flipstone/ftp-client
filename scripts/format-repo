#!/bin/sh

set -o errexit

. scripts/lib/run-in-container.sh

if [ "$CI" ]; then
  # The container runs as root against a bind mounted checkout owned by the
  # runner, so git refuses to read it without this.
  git config --global --add safe.directory "$PWD"
  MODE=check
else
  MODE=inplace
fi

git ls-files -z '*.hs' | xargs -0 fourmolu --mode "$MODE"
